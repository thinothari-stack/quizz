{% extends "admin/index.html.twig" %}
{% block title %}Contact!{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <style>
        #image-preview{
            height:auto;
            width:auto;
            max-width: 300px;
            max-height: 200px;
        }
    </style>
{% endblock %}
{% block body %}
    <div class="pagetitle">
      <h1>Contact(s)</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
          <li class="breadcrumb-item">Contact(s)</li>
          <li class="breadcrumb-item active">Data</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-lg-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Liste(s) de(s) contact(s)</h5>
              <div id="info" style="display: none;" class="alert alert-alt alert-success alert-dismissible hidden" role="alert">
                 <a class="alert-link" href="javascript:void(0)"><strong>INFO: </strong> <span id="msg"></span></a>
              </div>
              <!-- Basic Modal -->
                {# <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addContactModal">
                    Ajouter
                </button> #}
                <div class="modal fade" id="addContactModal" tabindex="-1">
                    <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                        <h5 class="modal-title">Contact</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form class="row g-3">
                                <div class="col-12">
                                    <label for="email" class="form-label">Email</label>
                                    <input type="text" class="form-control" id="email" name="email">
                                    <div id="alert" style="display: none;" class="alert alert-alt alert-danger alert-dismissible hidden" role="alert">
                                        <a class="alert-link" href="javascript:void(0)"><strong>INFO : </strong>Veuillez remplir l'e-mail.</a>
                                    </div>
                                    <label for="nom" class="form-label">Nom</label>
                                    <input type="text" class="form-control" id="nom" name="nom">
                                    <div id="alert2" style="display: none;" class="alert alert-alt alert-danger alert-dismissible hidden" role="alert">
                                        <a class="alert-link" href="javascript:void(0)"><strong>INFO : </strong>Veuillez remplir le nom.</a>
                                    </div>
                                    <label for="telephone" class="form-label">Téléphone</label>
                                    <input type="text" class="form-control" id="telephone" name="telephone">
                                    <div id="alert3" style="display: none;" class="alert alert-alt alert-danger alert-dismissible hidden" role="alert">
                                        <a class="alert-link" href="javascript:void(0)"><strong>INFO : </strong>Veuillez remplir le téléphone</a>
                                    </div>
                                </div>
                            </form><!-- Vertical Form -->
                        </div>
                        <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" onclick="cancelContact()" data-bs-dismiss="modal">Annuler</button>
                        <button type="button" class="btn btn-primary" onclick="addContact()">Ajouter</button>
                        </div>
                    </div>
                    </div>
                </div><!-- End Basic Modal-->
              <div id="viewContact"></div>
            </div>
          </div>

        </div>
      </div>
    </section>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{ asset('assets/global/vendor/datatables.net/jquery.dataTables.js') }}"></script>
    <script src="{{ asset('assets/global/vendor/datatables.net-bs4/dataTables.bootstrap4.js') }}"></script>
    <!-- <script src="{{ asset('assets/global/vendor/datatables.net-responsive/dataTables.responsive.js') }}"></script>
    <script src="{{ asset('assets/global/vendor/datatables.net-responsive-bs4/responsive.bootstrap4.js') }}"></script> -->
    <script src="{{ asset('assets/global/vendor/datatables.net-buttons/dataTables.buttons.js') }}"></script>
    <script src="{{ asset('assets/global/vendor/datatables.net-buttons/buttons.html5.js') }}"></script>
    <script src="{{ asset('assets/global/vendor/datatables.net-buttons/buttons.flash.js') }}"></script>
    <script src="{{ asset('assets/global/vendor/datatables.net-buttons/buttons.print.js') }}"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="{{ asset('assets/global/vendor/datatables.net-buttons/buttons.colVis.js') }}"></script>
    <script src="{{ asset('assets/global/vendor/datatables.net-buttons-bs4/buttons.bootstrap4.js') }}"></script>
    <script type="text/javascript">
        viewContact();
        function viewContact() {
            //Ajax get list Contact
            $.ajax({
                type: "GET",
                url: "{{ path('app_admin_contact_list') }}",
                error: function() {
                    console.log('Erreur de connexion');
                },
                success: function(data)  {
                    $("#viewContact").html(data);
                }
            });
            //End of Ajax
        }
        function addContact() {
            if($('#email').val() == '') {
                $("#alert").show("slow").delay(2000).slideUp("slow");
            }
            if($("#nom").val() == ''){
                $("#alert2").show("slow").delay(2000).slideUp("slow");
            }
            if($("#telephone").val() == ''){
                $("#alert3").show("slow").delay(2000).slideUp("slow");
            }
            if(($('#email').val() != '') && ($("#nom").val() != '') && ($("#telephone").val() != '')) {
                contactData = new FormData();
                contactData.append('email', $('#email').val());
                contactData.append('nom', $('#nom').val());
                contactData.append('telephone', $('#telephone').val());
                // Ajax add Contact
                let url = "{{ path('app_admin_contact') }}";
                $.ajax({
                    type: "POST",
                    url: url,
                    data: contactData,
                    dataType: 'json',
                    mimeType: 'multipart/form-data',
                    contentType: false,
                    cache: false,
                    processData: false,
                    error: function(e) {
                    },
                    success: function(data)  {
                        $("#addContactModal").modal('hide');
                        $("#info").show("slow").delay(3000).slideUp("slow");
                        $("#msg").html(data.info);
                        viewContact();
                        cancelContact();
                    }
                });
                // End Ajax add Contact
            }
        }
        function editContact(idContact){
            if($('#email'+idContact).val() == '') {
                $("#alert"+idContact).show("slow").delay(2000).slideUp("slow");
            }
            if($('#nom'+idContact).val() == '') {
                $("#alert2"+idContact).show("slow").delay(2000).slideUp("slow");
            }
            if($('#telephone'+idContact).val() == '') {
                $("#alert3"+idContact).show("slow").delay(2000).slideUp("slow");
            }
            if(($('#email'+idContact).val() != '') && ($('#nom'+idContact).val() != '') && ($('#telephone'+idContact).val() != '')) {
                contactData = new FormData();
                contactData.append('idContact', idContact);
                contactData.append('email', $('#email'+idContact).val());
                contactData.append('nom', $('#nom'+idContact).val());
                contactData.append('telephone', $('#telephone'+idContact).val());
                //Ajax delete Contact
                let url = "{{ path('app_admin_contact_edit') }}";
                $.ajax({
                    type: "POST",
                    url: url,
                    data: contactData,
                    dataType: 'json',
                    mimeType: 'multipart/form-data',
                    contentType: false,
                    cache: false,
                    processData: false,
                    error: function(e) {
                    },
                    /*beforeSend : function(){
                        $("#loadMe").modal({
                            backdrop: "static", //remove ability to close modal with click
                            keyboard: false, //remove option to close with keyboard
                            show: true //Display loader!
                        });
                    },*/
                    success: function(data)  {
                        $("#editContactModal"+idContact).modal('hide');
                        $("#info").show("slow").delay(3000).slideUp("slow");
                        $("#msg").html(data.info);
                        viewContact();
                    }/*,
                    complete: function(){
                        $("#loadMe").modal("hide");
                    }*/
                });
            }
        }
        function deleteContact(idContact){
            contactData = new FormData();
            contactData.append('idContact', idContact);
            //Ajax delete Contact
            let url = "{{ path('app_admin_contact_delete') }}";
            $.ajax({
                type: "POST",
                url: url,
                data: contactData,
                dataType: 'json',
                mimeType: 'multipart/form-data',
                contentType: false,
                cache: false,
                processData: false,
                error: function(e) {
                },
                /*beforeSend : function(){
                    $("#loadMe").modal({
                        backdrop: "static", //remove ability to close modal with click
                        keyboard: false, //remove option to close with keyboard
                        show: true //Display loader!
                    });
                },*/
                success: function(data)  {
                    $("#deleteContactModal"+idContact).modal('hide');
                    $("#info").show("slow").delay(3000).slideUp("slow");
                    $("#msg").html(data.info);
                    viewContact();
                }/*,
                complete: function(){
                    $("#loadMe").modal("hide");
                }*/
            });
            //End Ajax delete Contact
        }
        function cancelContact(){
            $('#email').val('');
            $('#nom').val('');
            $('#telephone').val('');
        }
    </script>
{% endblock %}