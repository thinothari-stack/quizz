{% extends "admin/index.html.twig" %}
{% block title %}Profil!{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <style>
        #image-preview{
            height:auto;
            width:auto;
            max-width: 300px;
            max-height: 200px;
        }
    </style>
{% endblock %}
{% block body %}
    <div class="pagetitle">
      <h1>Profil(s)</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('app_admin') }}">Home</a></li>
          <li class="breadcrumb-item">Profil(s)</li>
          <li class="breadcrumb-item active">Data</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
      <div class="row">
        <div class="col-lg-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Liste(s) de(s) profil(s)</h5>
              <div id="info" style="display: none;" class="alert alert-alt alert-success alert-dismissible hidden" role="alert">
                 <a class="alert-link" href="javascript:void(0)"><strong>INFO: </strong> <span id="msg"></span></a>
              </div>
              <!-- Basic Modal -->
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProfilModal">
                    Ajouter
                </button>
                <div class="modal fade" id="addProfilModal" tabindex="-1">
                    <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                        <h5 class="modal-title">Profil</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form class="row g-3">
                                <div class="col-12">
                                    <label for="designation" class="form-label">Désignation</label>
                                    <input type="text" class="form-control" id="designation" name="designation">
                                    <div id="alert" style="display: none;" class="alert alert-alt alert-danger alert-dismissible hidden" role="alert">
                                        <a class="alert-link" href="javascript:void(0)"><strong>INFO : </strong>Veuillez remplir la désignation.</a>
                                    </div>
                                    <label for="image" class="form-label">Image</label>
                                    <input type="file" accept="image/*" id="image" class="form-control" name="image">
                                    <div id='img_contain'>
                                        <img id="image-preview" align='middle'src="" alt="" title=''/>
                                    </div>
                                    <div id="alert2" style="display: none;" class="alert alert-alt alert-danger alert-dismissible hidden" role="alert">
                                        <a class="alert-link" href="javascript:void(0)"><strong>INFO : </strong>Veuillez remplir l'image.</a>
                                    </div>
                                    {# <input type="text" id="qty" placeholder="Quantité"/>
                                    <button type="button" class="btn btn-primary" id="submit-qty">Add</button> #}
                                </div>
                            </form><!-- Vertical Form -->
                        </div>
                        <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" onclick="cancelProfil()" data-bs-dismiss="modal">Annuler</button>
                        <button type="button" class="btn btn-primary" onclick="addProfil()">Ajouter</button>
                        </div>
                    </div>
                    </div>
                </div><!-- End Basic Modal-->
              <div id="viewProfil"></div>
            </div>
          </div>

        </div>
      </div>
    </section>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{ asset('assets/global/vendor/datatables.net/jquery.dataTables.js') }}"></script>
    <script src="{{ asset('assets/global/vendor/datatables.net-bs4/dataTables.bootstrap4.js') }}"></script>
