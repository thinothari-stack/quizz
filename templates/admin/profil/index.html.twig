    <script type="text/javascript">
        viewProfil();
        // $(document).keydown(function(event){
        //     var keycode = (event.keyCode ? event.keyCode : event.which);
        //     if(keycode == '13'){
        //         // console.log('You pressed a "enter" key in somewhere'); 
        //         $( "#submit-qty" ).trigger( "click" ); 
        //     }
        // });
        // $('#submit-qty').click(function(){
        //     console.log($('#qty').val());
        // });
        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                $('#image-preview').attr('src', e.target.result);
                $('#image-preview').hide();
                $('#image-preview').fadeIn(650);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
        function readURLDetail(input, str) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                $('#image-preview'+str).attr('src', e.target.result);
                $('#image-preview'+str).hide();
                $('#image-preview'+str).fadeIn(650);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
        $("#image").change(function() {
            readURL(this);
        }); 
        // $("#image"+str).change(function() {
        //     readURL(this);
        // });
        function viewProfil() {
            //Ajax get list profil
            $.ajax({
                type: "GET",
                url: "{{ path('app_admin_profil_list') }}",
                error: function() {
                    console.log('Erreur de connexion');
                },
                success: function(data)  {
                    $("#viewProfil").html(data);
                }
            });
            //End of Ajax
        }
        function addProfil() {
            if($('#designation').val() == '') {
                $("#alert").show("slow").delay(2000).slideUp("slow");
            }
            if($("#image")[0].files.length == 0){
                $("#alert2").show("slow").delay(2000).slideUp("slow");
            }
            if(($('#designation').val() != '') && ($("#image")[0].files.length != 0)) {
                // console.log($('#image')[0].files[0]);
                profilData = new FormData();
                profilData.append('designation', $('#designation').val());
                profilData.append('image', $('#image')[0].files[0]);
                // Ajax add Profil
                let url = "{{ path('app_admin_profil') }}";
                $.ajax({
                    type: "POST",
                    url: url,
                    data: profilData,
                    dataType: 'json',
                    mimeType: 'multipart/form-data',
                    contentType: false,
                    cache: false,
                    processData: false,
                    error: function(e) {
                    },
                    success: function(data)  {
                        $("#addProfilModal").modal('hide');
                        $("#info").show("slow").delay(3000).slideUp("slow");
                        $("#msg").html(data.info);
                        viewProfil();
                        cancelProfil();
                    }
                });
                // End Ajax add Profil
            }
        }
        function detailProfil(idProfil){
            $("#image"+idProfil).change(function() {
                readURLDetail(this, idProfil);
            });
            $("#image-preview"+idProfil).css({"height":"200px","width":"auto","max-height":"200px","max-width":"300px"});
        }
        function editProfil(idProfil){
            if($('#designation'+idProfil).val() == '') {
                $("#alert"+idProfil).show("slow").delay(2000).slideUp("slow");
            }
            if($("#image"+idProfil)[0].files.length == 0){
                $("#alert2"+idProfil).show("slow").delay(2000).slideUp("slow");
            }
            if(($('#designation'+idProfil).val() != '') && ($("#image"+idProfil)[0].files.length != 0)) {
                profilData = new FormData();
                profilData.append('idProfil', idProfil);
                profilData.append('designation', $('#designation'+idProfil).val());
                profilData.append('image', $('#image'+idProfil)[0].files[0]);
                //Ajax delete Profil
                let url = "{{ path('app_admin_profil_edit') }}";
                $.ajax({
                    type: "POST",
                    url: url,
                    data: profilData,
                    dataType: 'json',
                    mimeType: 'multipart/form-data',
                    contentType: false,
                    cache: false,
                    processData: false,
                    error: function(e) {
                    },
                    /*beforeSend : function(){
                        $("#loadMe").modal({
                            backdrop: "static", //remove ability to close modal with click
                            keyboard: false, //remove option to close with keyboard
                            show: true //Display loader!
                        });
                    },*/
                    success: function(data)  {
                        $("#editProfilModal"+idProfil).modal('hide');
                        $("#info").show("slow").delay(3000).slideUp("slow");
                        $("#msg").html(data.info);
                        viewProfil();
                    }/*,
                    complete: function(){
                        $("#loadMe").modal("hide");
                    }*/
                });
            }
        }
        function deleteProfil(idProfil){
            profilData = new FormData();
            profilData.append('idProfil', idProfil);
            //Ajax delete Profil
            let url = "{{ path('app_admin_profil_delete') }}";
            $.ajax({
                type: "POST",
                url: url,
                data: profilData,
                dataType: 'json',
                mimeType: 'multipart/form-data',
                contentType: false,
                cache: false,
                processData: false,
                error: function(e) {
                },
                /*beforeSend : function(){
                    $("#loadMe").modal({
                        backdrop: "static", //remove ability to close modal with click
                        keyboard: false, //remove option to close with keyboard
                        show: true //Display loader!
                    });
                },*/
                success: function(data)  {
                    $("#deleteProfilModal"+idProfil).modal('hide');
                    $("#info").show("slow").delay(3000).slideUp("slow");
                    $("#msg").html(data.info);
                    viewProfil();
                }/*,
                complete: function(){
                    $("#loadMe").modal("hide");
                }*/
            });
            //End Ajax delete Profil
        }
        function cancelProfil(){
            $('#designation').val('');
        }
    </script>
{% endblock %}