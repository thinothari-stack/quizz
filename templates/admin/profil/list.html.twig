<!-- Table with stripped rows -->
<table id="profilTable" class="table datatable">
<thead>
    <tr>
    <th scope="col">#</th>
    <th scope="col">Désignation</th>
    <th scope="col">Action</th>
    </tr>
</thead>
<tbody>
    {% for profil in Profil %}
    <tr>
    <th scope="row">{% set counter = ( counter | default(0) ) + 1 %}{{ counter }}</th>
    <td>{{ profil.designation }}</td>
    <td>
        <button type="button" onclick="detailProfil('{{ profil.id }}')" data-bs-target="#editProfilModal{{ profil.id }}" data-bs-toggle="modal" class="btn btn-sm btn-warning">
            <i class="bi bi-pencil" aria-hidden="true"></i>
        </button>
        <div class="modal fade" id="editProfilModal{{ profil.id }}" tabindex="-1">
            <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                <h5 class="modal-title">Edition</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="row g-3">
                        <div class="col-12">
                            <label for="designation{{ profil.id }}" class="form-label">Désignation</label>
                            <input type="text" class="form-control" id="designation{{ profil.id }}" name="designation" value="{{ profil.designation }}">
                            <div id="alert{{ profil.id }}" style="display: none;" class="alert alert-alt alert-danger alert-dismissible hidden" role="alert">
                                <a class="alert-link" href="javascript:void(0)"><strong>INFO : </strong>Veuillez remplir la désignation.</a>
                            </div>
                            <label for="image" class="form-label">Image</label>
                            <input type="file" accept="image/*" id="image{{ profil.id }}" class="form-control" name="image" value="{{ profil.image }}">
                            <div id='img_contain{{ profil.id }}'>
                                <img id="image-preview{{ profil.id }}" align='middle'src="{{ asset('profil') }}/{{ profil.image }}" alt="" title=''/>
                            </div>
                            <div id="alert2{{ profil.id }}" style="display: none;" class="alert alert-alt alert-danger alert-dismissible hidden" role="alert">
                                <a class="alert-link" href="javascript:void(0)"><strong>INFO : </strong>Veuillez remplir l'image.</a>
                            </div>
                        </div>
                    </form><!-- Vertical Form -->
                </div>
                <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" onclick="editProfil('{{ profil.id }}')">Editer</button>
                </div>
            </div>
            </div>
        </div><!-- End Basic Modal-->
        <button type="button" data-bs-target="#deleteProfilModal{{ profil.id }}" data-bs-toggle="modal" class="btn btn-sm btn-danger">
            <i class="bi bi-trash" aria-hidden="true"></i>
        </button>
        <div class="modal fade" id="deleteProfilModal{{ profil.id }}" tabindex="-1">
            <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                <h5 class="modal-title">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <p><i class="bi bi-exclamation-triangle" aria-hidden="true" style="font-size: 64px; color: orange"></i></p>
                    <h3>Vous êtes sur ?</h3>
                    <p>La suppression sera irréversible!</p>
                </div>
                <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Non</button>
                <button type="button" class="btn btn-primary" onclick="deleteProfil('{{ profil.id }}')">Oui</button>
                </div>
            </div>
            </div>
        </div><!-- End Basic Modal-->
    </td>
    </tr>
    {% endfor %}
</tbody>
</table>
