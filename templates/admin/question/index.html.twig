    <script type="text/javascript">
        viewQuestion();
        function viewQuestion() {
            //Ajax get list question
            $.ajax({
                type: "GET",
                url: "{{ path('app_admin_question_list') }}",
                error: function() {
                    console.log('Erreur de connexion');
                },
                success: function(data)  {
                    $("#viewQuestion").html(data);
                }
            });
            //End of Ajax
        }
        function addQuestion () {
            if($('#Type').val() == '') {
                $("#alert").show("slow").delay(2000).slideUp("slow");
            }
            if($('#designation').val() == '') {
                $("#alert2").show("slow").delay(2000).slideUp("slow");
            }
            if(($('#Type').val() != '') && ($('#designation').val() != '')) {
                questionData = new FormData();
                questionData.append('Type', $('#Type').val());
                questionData.append('designation', $('#designation').val());
                //Ajax add Question
                let url = "{{ path('app_admin_question') }}";
                $.ajax({
                    type: "POST",
                    url: url,
                    data: questionData,
                    dataType: 'json',
                    mimeType: 'multipart/form-data',
                    contentType: false,
                    cache: false,
                    processData: false,
                    error: function(e) {
                    },
                    success: function(data)  {
                        $("#addQuestionModal").modal('hide');
                        $("#info").show("slow").delay(3000).slideUp("slow");
                        $("#msg").html(data.info);
                        viewQuestion();
                        cancelQuestion();
                    }
                });
                //End Ajax add Question
            }
        }
        function editQuestion(idQuestion){
            if($('#Type'+idQuestion).val() == '') {
                $("#alert"+idQuestion).show("slow").delay(2000).slideUp("slow");
            }
            if($('#designation'+idQuestion).val() == '') {
                $("#alert2"+idQuestion).show("slow").delay(2000).slideUp("slow");
            }
            if(($('#Type'+idQuestion).val() != '') && ($('#designation'+idQuestion).val() != '')) {
                questionData = new FormData();
                questionData.append('idQuestion', idQuestion);
                questionData.append('Type', $('#Type'+idQuestion).val());
                questionData.append('designation', $('#designation'+idQuestion).val());
                //Ajax delete Question
                let url = "{{ path('app_admin_question_edit') }}";
                $.ajax({
                    type: "POST",
                    url: url,
                    data: questionData,
                    dataType: 'json',
                    mimeType: 'multipart/form-data',
                    contentType: false,
                    cache: false,
                    processData: false,
                    error: function(e) {
                    },
                    /*beforeSend : function(){
                        $("#loadMe").modal({
                            backdrop: "static", //remove ability to close modal with click
                            keyboard: false, //remove option to close with keyboard
                            show: true //Display loader!
                        });
                    },*/
                    success: function(data)  {
                        $("#editQuestionModal"+idQuestion).modal('hide');
                        $("#info").show("slow").delay(3000).slideUp("slow");
                        $("#msg").html(data.info);
                        viewQuestion();
                    }/*,
                    complete: function(){
                        $("#loadMe").modal("hide");
                    }*/
                });
            }
        }
        function deleteQuestion(idQuestion){
            questionData = new FormData();
            questionData.append('idQuestion', idQuestion);
            //Ajax delete Question
            let url = "{{ path('app_admin_question_delete') }}";
            $.ajax({
                type: "POST",
                url: url,
                data: questionData,
                dataType: 'json',
                mimeType: 'multipart/form-data',
                contentType: false,
                cache: false,
                processData: false,
                error: function(e) {
                },
                /*beforeSend : function(){
                    $("#loadMe").modal({
                        backdrop: "static", //remove ability to close modal with click
                        keyboard: false, //remove option to close with keyboard
                        show: true //Display loader!
                    });
                },*/
                success: function(data)  {
                    $("#deleteQuestionModal"+idQuestion).modal('hide');
                    $("#info").show("slow").delay(3000).slideUp("slow");
                    $("#msg").html(data.info);
                    viewQuestion();
                }/*,
                complete: function(){
                    $("#loadMe").modal("hide");
                }*/
            });
            //End Ajax delete Question
        }
        function cancelQuestion(){
            $('#designation').val('');
        }
    </script>
{% endblock %}