<script>
    $(document).ready(function() {
        // $("body").css({ opacity: 0.7 });
        const slider = $(".slider");
        const slides = slider.find(".slide");
        let currentIndex = 0;
        const transitionDuration = 2000; // Animation duration in milliseconds
        const prevButton = $(".prev-button");
        const nextButton = $(".next-button");

        const sendButton = $(".send-button")

        const slides1 = slider.find(".slide1");
        slides1.hide();

        function showCurrentSlide() {
             $(".slide.active").animate({ scrollTop: 0 }, "slow");
             $("html, body").animate({ scrollTop: 0 }, "slow");
            slides.removeClass('active');
            slides.eq(currentIndex).addClass('active');
            // slides.slideUp("slow").delay(1000).eq(currentIndex).slideDown("slow").delay(1000);
            // slides.removeClass("active");
            // slides.eq(currentIndex).addClass("active");
            // const currentQuestion = slides.eq(currentIndex);
            // const image = currentQuestion.data("image");
            // $("body").animate({ opacity: 0 }, transitionDuration, function() {
            //     $(this).css("background-image", `url(${image})`).animate({ opacity: 1 }, transitionDuration);
            // });
            // const body = $("body");
            // body.fadeOut(transitionDuration, function() {
            //     body.css("background-image", `url(${image})`).fadeIn(transitionDuration);
            // });
        }

        function showNextSlide() {
            // if ($('#quizz_profile').find('input:checked').length > 0) {
                currentIndex = (currentIndex + 1) % slides.length;
                slideCount = slides.length - 1;
                if (slideCount == currentIndex) {
                    ajaxPartResult();
                    // const currentQuestion = slides.eq(currentIndex);
                    // const image = currentQuestion.data("image");
                    // $("body").animate({ opacity: 0 }, transitionDuration, function() {
                    //     $(this).css("background-image", `url(${image})`).animate({ opacity: 1 }, transitionDuration);
                    // });
                    // const body = $("body");
                    // body.fadeOut(transitionDuration, function() {
                    //     body.css("background-image", `url(${image})`).fadeIn(transitionDuration);
                    // });
                }
                // slider.animate({ marginLeft: -(currentIndex * 100) + "%" });
                showCurrentSlide();
            // } else {
            //     console.log('vide');
            // }
        }

        function showPreviousSlide() {
            currentIndex = (currentIndex - 1 + slides.length) % slides.length;
            // slider.animate({ marginLeft: -(currentIndex * 100) + "%" });
            showCurrentSlide();
        }

        nextButton.on("click", showNextSlide);
        prevButton.on("click", showPreviousSlide);

        showCurrentSlide();

        function cancelInfos() {
            $('#nom').val('');
            $('#email').val('');
            $('#telephone').val('');
        }

        function ajaxPartResult(){
            var formData = new FormData();
            $('#quizz_profile').find('input[type="radio"]:checked').each(function() {
                var serializedData = $(this).serializeArray();
                $.each(serializedData, function(index, field) {
                    formData.append(field.name, field.value);
                });
            });
            let url = "{{ path('app_quizz_result') }}";
            $.ajax({
                type: "POST",
                url: url,
                data: formData,
                dataType: 'json',
                mimeType: 'multipart/form-data',
                contentType: false,
                cache: false,
                processData: false,
                error: function(e) {
                    console.log('erreur');
                },
                success: function(data)  {
                    $('#viewResultDesignation').html(data.profil);
                    var id = data.profil_id;
                    var urlPicture = '{{ path('app_admin_profil_ajax', {'id': 'id'}) }}';
                    urlPicture = urlPicture.replace("id", id);
                    // console.log(urlPicture);
                    $.getJSON(urlPicture, function(data) {
                        $('#viewResultImage').html("<img width='50%' src="+data.path+" alt="+data.image+" class=''>");
                    });
                    sendButton.on('click', function(){
                        if($('#nom').val() == '') {
                            $("#alert").show("slow").delay(2000).slideUp("slow");
                        }
                        if($('#email').val() == '') {
                            $("#alert2").show("slow").delay(2000).slideUp("slow");
                        }
                        if($('#telephone').val() == '') {
                            $("#alert3").show("slow").delay(2000).slideUp("slow");
                        }
                        if(($('#nom').val() != '') && ($('#email').val() != '') && ($('#telephone').val() != '')) {
                            formData2 = new FormData();
                            formData2.append('nom', $('#nom').val());
                            formData2.append('email', $('#email').val());
                            formData2.append('telephone', $('#telephone').val());
                            formData2.append('profil_id', data.profil_id);
                            let url = "{{ path('app_quizz_send') }}";
                            $.ajax({
                                type: "POST",
                                url: url,
                                data: formData2,
                                dataType: 'json',
                                mimeType: 'multipart/form-data',
                                contentType: false,
                                cache: false,
                                processData: false,
                                error: function(e) {
                                    console.log('erreur');
                                },
                                success: function(data)  {
                                    cancelInfos();
                                    $("#info").show("slow").delay(3000).slideUp("slow");
                                    $("#msg").html(data.info);
                                    // $(".form-contact").slideUp("slow");
                                    // console.log(data.pdf)
                                }
                            });
                        }
                    }); 
                }
            });
        }

    });
</script>
